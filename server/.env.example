# PostgreSQL. The server connects as the easyshot_app role (NOSUPERUSER NOBYPASSRLS, created
# by migration 0004 locally; create it yourself in production). Migrations run as the owner.
DATABASE_URL=postgres://easyshot_app:easyshot_app@localhost:5432/easyshot_dev?sslmode=disable
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/easyshot_dev?sslmode=disable
# Apply migrations at startup (otherwise: easyshot-server migrate up / mise run db:migrate).
RUN_MIGRATIONS=true
DB_MAX_CONNECTIONS=5
# S3_BUCKET falls back to BUCKET_NAME (set by Fly's Tigris integration)
S3_BUCKET=easyshot

# Server
BIND_ADDR=0.0.0.0:8080
PUBLIC_BASE_URL=http://localhost:8080
RUST_LOG=info
# Keys password-unlock cookies and view hashes; random per process when unset.
WEB_SECRET=dev-web-secret
# Reverse proxies that set X-Forwarded-For in front of the server (Fly: 1).
TRUSTED_PROXY_HOPS=0
# DOWNLOAD_URL=https://github.com/mscno/shotglass/releases/latest

# Object storage (S3_ENDPOINT + path style for MinIO / R2; leave empty for AWS S3)
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# S3_REGION falls back to AWS_REGION (Tigris: auto). AWS_ENDPOINT_URL_S3 is honored by the SDK
# when S3_ENDPOINT is unset (Tigris: https://fly.storage.tigris.dev; keep path style off).
# Credentials come from the standard AWS chain (env vars, profile, IAM role).
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Behaviour
RETENTION_DAYS=30
VIDEO_RETENTION_DAYS=90
# Users with no login/session/API-token activity for this many days are purged (with all
# their screenshots and videos) by POST /v1/internal/expire. 0 disables.
INACTIVE_USER_DAYS=90
MAX_UPLOAD_BYTES=26214400
MAX_VIDEO_BYTES=5368709120
ALLOW_SIGNUPS=true

# Bearer secret for POST /v1/internal/expire (endpoint returns 404 when unset)
CRON_SECRET=dev-cron-secret

# Email (Lettermint) - enables email confirmation, password reset, OTP and web sign-in codes,
# and "send to" from the library. Leave LETTERMINT_API_TOKEN unset to run without email.
# LETTERMINT_API_TOKEN=lm_...      # project token (secret)
# MAIL_FROM=Easyshot <no-reply@your-verified-domain>
# LETTERMINT_ROUTE=transactional  # default
# LETTERMINT_API_URL=https://api.lettermint.co/v1
# REQUIRE_EMAIL_VERIFICATION=      # default: true when LETTERMINT_API_TOKEN is set
# AUTH_CODE_TTL_MINUTES=10

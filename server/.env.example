# Required. Backend is chosen by the URL scheme:
#   postgres://... | postgresql://...            Postgres
#   libsql://<db>-<org>.turso.io | https://...   Turso (needs DATABASE_AUTH_TOKEN)
#   file:shotglass.db | file::memory:            local libSQL/SQLite file (dev, no Docker)
DATABASE_URL=postgres://shotglass:shotglass@localhost:5432/shotglass
# DATABASE_URL=file:shotglass.db
# DATABASE_AUTH_TOKEN=            # Turso auth token (remote libsql only)
# S3_BUCKET falls back to BUCKET_NAME (set by Fly's Tigris integration)
S3_BUCKET=shotglass

# Server
BIND_ADDR=0.0.0.0:8080
PUBLIC_BASE_URL=http://localhost:8080
RUST_LOG=info

# Object storage (S3_ENDPOINT + path style for MinIO / R2; leave empty for AWS S3)
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# S3_REGION falls back to AWS_REGION (Tigris: auto). AWS_ENDPOINT_URL_S3 is honored by the SDK
# when S3_ENDPOINT is unset (Tigris: https://fly.storage.tigris.dev; keep path style off).
# Credentials come from the standard AWS chain (env vars, profile, IAM role).
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Behaviour
RETENTION_DAYS=30
# Users with no login/session/API-token activity for this many days are purged (with all
# their screenshots) by POST /v1/internal/expire. 0 disables.
INACTIVE_USER_DAYS=90
MAX_UPLOAD_BYTES=26214400
ALLOW_SIGNUPS=true
RUN_MIGRATIONS=true
DB_MAX_CONNECTIONS=5

# Bearer secret for POST /v1/internal/expire (endpoint returns 404 when unset)
CRON_SECRET=dev-cron-secret

# Email (Lettermint) - enables email confirmation, password reset and OTP sign-in codes.
# Leave LETTERMINT_API_TOKEN unset to run without email (those endpoints answer 503).
# LETTERMINT_API_TOKEN=lm_...      # project token (secret)
# MAIL_FROM=Shotglass <no-reply@your-verified-domain>
# LETTERMINT_ROUTE=transactional  # default
# LETTERMINT_API_URL=https://api.lettermint.co/v1
# REQUIRE_EMAIL_VERIFICATION=      # default: true when LETTERMINT_API_TOKEN is set
# AUTH_CODE_TTL_MINUTES=10
